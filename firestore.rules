rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================================================
    // Fonctions d'aide globales.
    // ===========================================================================

    // L'utilisateur est connecté.
    function isSignedIn() {
      return request.auth != null;
    }

    // L'utilisateur est actif (actif == true) — condition de base de tout accès.
    function isActif() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.actif == true;
    }

    // Rôle "admin" ET actif.
    function isAdmin() {
      return isActif()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rôle "pharmacien" ET actif.
    function isPharmacien() {
      return isActif()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacien';
    }

    // Soit admin, soit pharmacien (deux rôles autorisés), tous deux actifs.
    function isActifRole() {
      return isActif() && (isAdmin() || isPharmacien());
    }

    // ===========================================================================
    // Profils utilisateurs.
    // ===========================================================================
    match /users/{uid} {
      // Lecture : un utilisateur actif lit son propre profil, un admin lit tout.
      allow read: if isActif() && (request.auth.uid == uid || isAdmin());

      // Création : uniquement par un admin (pas d'inscription publique).
      allow create: if isAdmin();

      // Mise à jour :
      //  - admin : tout profil (activation / désactivation...)
      //  - utilisateur actif : uniquement son propre champ lastLogin.
      allow update: if isAdmin()
        || (isActif()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));

      // Suppression : uniquement par un admin.
      allow delete: if isAdmin();
    }

    // ===========================================================================
    // Médicaments : lecture pour tout utilisateur actif (la caisse en a besoin),
    // écriture réservée à l'admin.
    // ===========================================================================
    match /medicaments/{id} {
      allow read: if isActif();
      allow write: if isAdmin();
    }

    // ===========================================================================
    // Stock : lecture pour tout actif. Écriture complète admin.
    // Un pharmacien ne peut décrémenter QUE le champ quantiteDisponible
    // (+ updatedAt) lors d'une vente (RG-06). Un update de vente reste donc
    // possible, mais pas de création de doc stock ni d'autres champs.
    // ===========================================================================
    match /stock/{id} {
      allow read: if isActif();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isActif()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['quantiteDisponible', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ===========================================================================
    // Mouvements de stock : lecture pour actif, création pour tout actif
    // (vente = sortie, annulation = entree), immuables ensuite.
    // ===========================================================================
    match /mouvementsStock/{id} {
      allow read: if isActif();
      allow create: if isActif();
      allow update, delete: if false;
    }

    // ===========================================================================
    // Ventes : création par tout actif (admin ou pharmacien).
    // Lecture : admin TOUTES les ventes, pharmacien UNIQUEMENT les siennes.
    // Mise à jour (annulation) : admin uniquement. Suppression interdite
    // (RG-12 : historiques conservés).
    // ===========================================================================
    match /ventes/{id} {
      allow read: if isAdmin()
        || (isPharmacien() && resource.data.utilisateurId == request.auth.uid);
      allow create: if isActifRole();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ===========================================================================
    // Factures : lecture / création pour tout actif, MAJ admin (annulation),
    // suppression interdite.
    // ===========================================================================
    match /factures/{id} {
      allow read: if isActif();
      allow create: if isActif();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ===========================================================================
    // Clients : lecture / création / MAJ pour tout actif, suppression admin.
    // ===========================================================================
    match /clients/{id} {
      allow read, create, update: if isActif();
      allow delete: if isAdmin();
    }

    // ===========================================================================
    // Compteurs annuels (numérotation séquentielle) : tout actif, verrouillé
    // par transaction côté code.
    // ===========================================================================
    match /compteurs/{annee} {
      allow read, write: if isActif();
    }

    // ===========================================================================
    // Par défaut : tout est refusé.
    // ===========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}